# Database (PostgreSQL) — Neon, Supabase, Vercel Postgres, etc.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth
JWT_SECRET="your-secret-min-32-chars-random-string"
ADMIN_PASSWORD="your-admin-password"

# App URL (for emails, links)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# Storage: use "cloudinary" on Vercel (local filesystem is read-only)
CLOUD_STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
